{
  "name": "vite-et-gourmand",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:bo": "pnpm --filter back-office dev",
    "dev:cl": "pnpm --filter client dev",
    "build:bo": "pnpm --filter back-office build",
    "build:cl": "pnpm --filter client build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "db:types:prod": "supabase gen types typescript --linked > packages/supabase/src/database.types.ts",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:link": "supabase link",
    "db:seed": "supabase db reset",
    "lint": "pnpm --parallel run lint",
    "typecheck": "pnpm --parallel run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "supabase": "^1.200.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "@swc/core",
      "unrs-resolver",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
