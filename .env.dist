# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vite (back-office)
VITE_API_URL=http://localhost:8080/api
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# Backend (Node / Hono / TypeORM)
# ============================================================
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgres://postgres:pass@localhost:5432/vite_et_gourmand
DB_USERNAME=postgres
DB_PASSWORD=pass
DB_DATABASE=vite_et_gourmand
AUTO_MIGRATION=false
LOG_SQL=false

# Mongo
MONGO_URL=mongodb://root:pass@localhost:27017/vite_et_gourmand?authSource=admin

# JWT
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ACCOUNT_TOKEN_SECRET=change-me
RESET_TOKEN_SECRET=change-me

# Email (Resend) - used in later phases
RESEND_API_KEY=
FROM_EMAIL=no-reply@vite-et-gourmand.com
CONTACT_EMAIL=contact@vite-et-gourmand.com

# URLs
FRONTEND_URL=http://localhost:3000
BACK_OFFICE_URL=http://localhost:5173
