# Client (Next.js) - backend API
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Vite (back-office)
VITE_API_URL=http://localhost:8080/api

# ============================================================
# Backend (Node / Hono / TypeORM)
# ============================================================
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgres://postgres:pass@localhost:5432/vite_et_gourmand
DB_USERNAME=postgres
DB_PASSWORD=pass
DB_DATABASE=vite_et_gourmand
AUTO_MIGRATION=false
LOG_SQL=false

# Mongo
MONGO_URL=mongodb://root:pass@localhost:27017/vite_et_gourmand?authSource=admin

# JWT
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ACCOUNT_TOKEN_SECRET=change-me
RESET_TOKEN_SECRET=change-me

# Email (Resend) - used in later phases
RESEND_API_KEY=
FROM_EMAIL=no-reply@vite-et-gourmand.com
CONTACT_EMAIL=contact@vite-et-gourmand.com

# URLs
FRONTEND_URL=http://localhost:3000
BACK_OFFICE_URL=http://localhost:3001

# ============================================================
# Déploiement Docker (docker-compose.prod.yml)
# ============================================================
# Identifiants root des bases (utilisés pour construire DATABASE_URL / MONGO_URL
# entre conteneurs — voir docker-compose.prod.yml).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=pass

# Ports exposés sur l'hôte (modifiables selon l'environnement).
BACKEND_PORT=8080
CLIENT_PORT=3000
BACK_OFFICE_PORT=3001
