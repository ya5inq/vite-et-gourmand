{
  "name": "backend",
  "version": "0.0.0",
  "main": "src/entrypoints/api/index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon",
    "clean": "pnpm rimraf dist",
    "build": "pnpm clean && tsc -p ./tsconfig.build.json && tsc-alias -p ./tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/entrypoints/api/index.js",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "pnpm lint --fix",
    "test:unit": "vitest run --config=vitest.config.unit.ts",
    "test:unit:coverage": "vitest run --config=vitest.config.unit.ts --coverage",
    "typeorm": "ts-node -P tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/infrastructure/database/typeorm.config.ts",
    "migration:generate": "pnpm typeorm migration:generate --pretty",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:create": "pnpm typeorm migration:create",
    "fixtures:load": "ts-node -r tsconfig-paths/register src/infrastructure/database/fixtures/scripts/setup.ts",
    "generate-openapi-doc": "ts-node -r tsconfig-paths/register src/entrypoints/api/openApi/generateOpenapiDocJson.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.14.4",
    "@hono/swagger-ui": "0.5.2",
    "@hono/zod-openapi": "0.19.8",
    "@hono/zod-validator": "0.7.0",
    "@scalar/hono-api-reference": "0.5.107",
    "bcryptjs": "3.0.2",
    "dotenv": "^16.4.7",
    "hono": "4.5.10",
    "i18next": "^25.7.1",
    "inversify": "6.0.2",
    "jsonwebtoken": "9.0.2",
    "lodash": "^4.17.21",
    "mongodb": "^6.21.0",
    "pg": "8.12.0",
    "pino": "9.3.1",
    "pino-pretty": "11.2.1",
    "reflect-metadata": "0.2.2",
    "resend": "4.0.1",
    "typeorm": "0.3.16",
    "uuid": "10.0.0",
    "zod": "3.23.8",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@faker-js/faker": "8.4.1",
    "@types/jsonwebtoken": "9.0.6",
    "@types/lodash": "^4.17.17",
    "@types/node": "20.14.9",
    "@types/pg": "8.11.6",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "7.17.0",
    "@typescript-eslint/parser": "7.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "copyfiles": "^2.4.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.2.1",
    "nodemon": "3.1.4",
    "prettier": "3.3.2",
    "rimraf": "^5.0.0",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.10",
    "tsconfig-paths": "4.2.0",
    "typeorm-fixtures-cli": "4.1.0",
    "typescript": "5.5.4",
    "vitest": "^3.2.4"
  },
  "author": "SnowPact",
  "license": "ISC"
}
